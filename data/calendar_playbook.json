{
 "about": "경제 일정 루틴의 검색 계획표. scripts/calendar_queries.py plan 이 오늘 날짜로 빈칸을 채워 실행 목록을 만든다. q 의 {..} 는 변수, when 은 적용 시기. status: core(사람이 관리) / trial(루틴이 제안, 7회 연속 0건이면 retired).",
 "vars_help": {
  "{y}": "올해",
  "{m}": "이번 달",
  "{wk}": "이번 달 몇째 주",
  "{d0}": "오늘 M월 D일",
  "{d5}": "5일 뒤 M월 D일",
  "{mon}": "이번(또는 다음) 주 월요일 M월 D일",
  "{mon_en}": "그 월요일 영어 (October 12)",
  "{q}": "실적 분기(직전 분기)",
  "{qy}": "그 분기의 연도",
  "{watch_kr}": "관심 종목(한국) 이름들",
  "{watch_us}": "관심 종목(미국 등) 이름들"
 },
